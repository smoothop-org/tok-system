\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Geometrical interpretation of the participant's degree of confidence $\theta _i$}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{figDegreeBoth}{{3}{8}{Geometrical interpretation of the participant's degree of confidence $\theta _i$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces participant $i$'s exchange velocities for an estimate of $\left [\alpha / \beta \right ]_i = 10$~$\alpha $ per~$\beta $ with a degree of confidence $\theta _i= 75 \%$. To compare both exchange velocities on a single axis, asset~B's velocity is converted to its $\alpha $-equivalent using the participant's own estimate, $\dot  {X}_i^\beta \left [\alpha / \beta \right ]_i$ — the fair conversion factor according to participant $i$, not the (generally different) market price $\left [\alpha / \beta \right ]_\Omega $.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{figExchangeSymmetry}{{4}{9}{participant $i$'s exchange velocities for an estimate of $\priceAB _i = 10$~$\alpha $ per~$\beta $ with a degree of confidence $\theta _i= 75 \%$. To compare both exchange velocities on a single axis, asset~B's velocity is converted to its $\alpha $-equivalent using the participant's own estimate, $\dot {X}_i^\beta \priceAB _i$ — the fair conversion factor according to participant $i$, not the (generally different) market price $\priceAB _\Omega $}{figure.caption.9}{}}
